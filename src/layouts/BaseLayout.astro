---
// Shell of every page: head, skip link, menu, main content and footer.
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	/** Image shared on social networks (imported, or the path of a drawn /og/… image); the site's one otherwise */
	image?: ImageMetadata | string;
	/** Describes the shared image */
	imageAlt?: string;
	/** Schema.org data for this page, written as JSON-LD in the head */
	jsonLd?: object;
	/** Lets full-width bands reach the edges of the window (home page) */
	bleed?: boolean;
	/** Article dates and topics, for the Open Graph article tags */
	article?: { published: Date; modified?: Date; tags: string[] };
	/** Keeps the page out of search results (404, drafts, thin topic pages) */
	noindex?: boolean;
}

const { title, description, image, imageAlt, jsonLd, bleed = false, article, noindex = false } = Astro.props;

// "<" escaped, so a title containing "</script>" can never close the JSON-LD block early
const jsonLdText = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			imageAlt={imageAlt}
			article={article}
			noindex={noindex}
		/>
		{jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Header />
		<main id="main" class:list={{ bleed }}>
			<slot />
		</main>
		<Footer />
	</body>
</html>
