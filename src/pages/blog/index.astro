---
import IssueArchive from '../../components/IssueArchive.astro';
import { BLOG_SHARE_IMAGE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getIssues, getTopics } from '../../utils/issues';

const issues = await getIssues();
const topics = getTopics(issues);
---

<BaseLayout
	title="Web scraping articles"
	image={BLOG_SHARE_IMAGE}
	description="Every JKS9 issue on web scraping in production, newest first: reliable scrapers, data pipelines, schema drift and alerts, in Node.js and TypeScript."
>
	<IssueArchive issues={issues} topics={topics} />
</BaseLayout>
