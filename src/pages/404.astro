---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Page not found" description="This page does not exist on the JKS9 site." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Page not found</h1>
			<p>This page does not exist, or it has moved.</p>
			<p><a href="/">Back to the home page</a> or <a href="/blog/">see all articles</a>.</p>
		</main>
		<Footer />
	</body>
</html>
