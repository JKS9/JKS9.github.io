---
// Mobile first. On a phone: the logo and a burger menu. The menu is a <details>,
// so it opens without JavaScript. From 640px: the links on one line.
import { GITHUB_URL, NAV_LINKS } from '../consts';
import { ariaCurrent } from '../utils/nav';
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';

const pathname = Astro.url.pathname;
---

<header>
	<div class="container bar">
		<a class="home" href="/"><Logo /></a>

		<details class="menu">
			<summary>
				<span class="sr-only">Menu</span>
				<span class="burger" aria-hidden="true">
					<span class="bars shifted"></span>
					<span class="bars"></span>
				</span>
				<svg class="close" aria-hidden="true" width="28" height="28" viewBox="0 0 28 28">
					<path class="shifted" d="M5 5 L23 23 M23 5 L5 23"></path>
					<path d="M5 5 L23 23 M23 5 L5 23"></path>
				</svg>
			</summary>
			<nav class="drawer" aria-label="Main">
				<ol>
					{
						NAV_LINKS.map((link, index) => (
							<li>
								<a href={link.href} aria-current={ariaCurrent(pathname, link.href)}>
									<span class="number" aria-hidden="true">
										{String(index + 1).padStart(2, '0')}
									</span>
									<span class="name">{link.label}</span>
								</a>
							</li>
						))
					}
				</ol>
				<p class="extra">
					<a class="external" href={GITHUB_URL}>GitHub <span aria-hidden="true">↗</span></a>
					<a href="/rss/" aria-current={ariaCurrent(pathname, '/rss/')}>RSS</a>
				</p>
			</nav>
		</details>

		<nav class="inline" aria-label="Main">
			<ul>
				{
					NAV_LINKS.map((link) => (
						<li>
							<HeaderLink href={link.href}>{link.label}</HeaderLink>
						</li>
					))
				}
				<li>
					<a class="external" href={GITHUB_URL}>GitHub <span aria-hidden="true">↗</span></a>
				</li>
			</ul>
		</nav>
	</div>
</header>

<style>
	header {
		/* Above the page, so the open menu covers it (the skip link stays above, at 10) */
		position: relative;
		z-index: 5;
		border-bottom: var(--border) solid var(--green);
		background: var(--paper);
	}
	.bar {
		--logo-size: 28px;
		--wordmark-size: 18px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px 24px;
		padding-block: 4px;
		/* The burger's 48px target spills into the gutter, its icon lines up with the text */
		padding-right: calc(var(--gutter) - 10px);
	}
	/* A flex box, not a line box: no strut space under the logo, so it stays centered on the links */
	.home {
		--logo-gap: 10px;
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		line-height: 1;
		text-decoration: none;
	}

	/* Burger: three bars printed in two inks, like the logo. Becomes a cross when open. */
	summary {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		cursor: pointer;
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	.burger {
		position: relative;
		display: block;
		width: 28px;
		height: 21px;
	}
	.bars {
		position: absolute;
		inset: 0;
		color: var(--green);
		background: linear-gradient(
			currentColor 0 3px,
			transparent 3px 9px,
			currentColor 9px 12px,
			transparent 12px 18px,
			currentColor 18px 21px
		);
		mix-blend-mode: multiply;
	}
	.bars.shifted {
		color: var(--orange);
		transform: translate(var(--misregistration), 2px);
	}
	.close {
		display: none;
		overflow: visible;
		fill: none;
		stroke: var(--green);
		stroke-width: 3.5;
		stroke-linecap: square;
	}
	.close path {
		mix-blend-mode: multiply;
	}
	.close .shifted {
		stroke: var(--orange);
		transform: translate(var(--misregistration), 2px);
	}
	.menu[open] .burger {
		display: none;
	}
	.menu[open] .close {
		display: block;
	}

	/* Open menu: a panel under the header, over the page, with an orange shadow */
	.drawer {
		position: absolute;
		top: calc(100% + var(--border));
		right: 0;
		left: 0;
		padding: 4px var(--gutter) 16px;
		border-bottom: var(--border) solid var(--green);
		background: var(--paper);
		box-shadow: 0 8px 0 var(--orange);
	}
	ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	ol li {
		border-bottom: var(--border-thin) dashed var(--green);
	}
	ol a {
		display: flex;
		align-items: baseline;
		gap: 16px;
		padding: 14px 0;
		color: var(--ink);
		text-decoration: none;
	}
	ol a:hover {
		color: var(--orange-text);
	}
	.number {
		color: var(--orange-text);
		font-size: 14px;
		font-weight: 700;
	}
	.name {
		font-family: var(--font-title);
		font-size: 28px;
		line-height: 1.2;
	}
	/* Same underline as the desktop menu */
	ol a[aria-current] .name {
		text-decoration: underline;
		text-decoration-color: var(--orange);
		text-decoration-thickness: 4px;
		text-underline-offset: 6px;
	}
	.extra {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin: 0;
		padding-top: 6px;
		font-size: 16px;
	}
	.extra a {
		padding: 12px 0;
	}
	.extra a[aria-current] {
		text-decoration-color: var(--orange);
		text-decoration-thickness: 3px;
		text-underline-offset: 5px;
	}

	/* Desktop menu */
	.inline {
		display: none;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 28px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.external {
		display: inline-block;
		padding: 12px 0;
		color: var(--green);
		font-weight: 700;
		text-decoration: none;
	}
	.external:hover {
		color: var(--orange-text);
	}

	@media (min-width: 640px) {
		.bar {
			--logo-size: 34px;
			--wordmark-size: 22px;
			flex-wrap: wrap;
			padding-block: 8px;
			padding-right: var(--gutter);
		}
		.home {
			--logo-gap: 12px;
		}
		.menu {
			display: none;
		}
		.inline {
			display: block;
		}
	}
</style>
