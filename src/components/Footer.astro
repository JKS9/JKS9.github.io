---
// Mobile first. On a phone: centered, the logo dots, the profiles, then "© · motto" under a dashed rule.
// From 720px: one thin line, the © and the profiles (the "Find me" links) on the left, the motto on the right.
// That line needs about 660px: below 720px it would break, so the centered version stays.
import { PROFILES } from '../consts';
import { ariaCurrent } from '../utils/nav';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
const pathname = Astro.url.pathname;
---

<footer>
	<div class="container">
		<span class="mark" aria-hidden="true"><Logo size={24} wordmark={false} /></span>
		<nav aria-label="Find me">
			{
				PROFILES.map((profile) => (
					<a href={profile.url} rel="me">
						{profile.name}
					</a>
				))
			}
			<a href="/rss/" aria-current={ariaCurrent(pathname, '/rss/')}>RSS</a>
		</nav>
		<p class="colophon">
			<span class="copyright">© {year} JKS9</span><span class="separator" aria-hidden="true"> · </span><span
				class="motto">No cookies. Just ink.</span
			>
		</p>
	</div>
</footer>

<style>
	footer {
		border-top: var(--border-thin) solid var(--green);
		color: var(--green);
		font-size: 14px;
	}
	.container {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
		padding-block: 24px 12px;
		text-align: center;
	}
	.mark {
		display: flex;
		margin-bottom: 4px;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0 22px;
	}
	nav a {
		padding: 12px 0;
	}
	nav a[aria-current] {
		text-decoration-color: var(--orange);
		text-decoration-thickness: 3px;
		text-underline-offset: 5px;
	}
	.colophon {
		width: 100%;
		margin: 4px 0 0;
		padding-top: 12px;
		border-top: var(--border-thin) dashed var(--green);
	}

	@media (min-width: 720px) {
		.container {
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: flex-start;
			gap: 0 16px;
			padding-block: 4px 8px;
			text-align: left;
		}
		.mark,
		.separator {
			display: none;
		}
		nav {
			gap: 0 16px;
		}
		/* The © joins the profiles on the left, the motto goes to the right */
		.colophon {
			display: contents;
		}
		.copyright {
			order: -1;
			padding: 12px 0;
		}
		.motto {
			order: 1;
			margin-left: auto;
			padding: 12px 0;
		}
	}
</style>
